{
  "name": "veyl-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env.local --watch server/index.ts",
    "start": "node --env-file=.env.local server/index.ts",
    "setup": "node scripts/setup.ts",
    "test": "node --test tests/*.test.ts",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "format": "prettier --write src server scripts tests docs *.json *.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
